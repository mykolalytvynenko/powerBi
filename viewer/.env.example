# Скопіюйте у .env (розробка) або /etc/mbviewer/mbviewer.env (сервер), права 600.

# Entra ID (дає Олексій)
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=change-me

# Публічна адреса застосунку, без слеша в кінці
BASE_URL=https://merch.vsisvoi.ua

# Випадковий рядок для підпису cookie: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Сайт SharePoint
SP_HOSTNAME=vsisvoi.sharepoint.com
SP_SITE_PATH=/sites/MerchandisingTest

# Як часто перечитувати списки, секунд
CACHE_TTL=120
# Куди зберігати мініатюри
IMAGE_CACHE_DIR=/var/cache/mbviewer

# Де слухає служба (типово 127.0.0.1:8000 за Nginx).
# За Traefik у k3s на сервері docker: хост 10.10.252.108, порт 8090, проксі з мережі подів.
# LISTEN_HOST=10.10.252.108
# LISTEN_PORT=8090
# FORWARDED_ALLOW_IPS=10.42.0.0/16

# Тільки для розробки на своєму комп'ютері:
# FAKE_DATA=1     демо-дані замість SharePoint
# AUTH_DISABLED=1 без входу через Entra
