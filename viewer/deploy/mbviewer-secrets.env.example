# Секрети для pod у k3s. Скопіюйте на сервер у /etc/mbviewer/mbviewer.env (права 600, власник root)
# і створіть з нього Secret:
#   sudo kubectl -n mbviewer create secret generic mbviewer-env --from-env-file=/etc/mbviewer/mbviewer.env
# Решта налаштувань (BASE_URL, сайт SharePoint, кеш) лежить у ConfigMap у k3s-mbviewer.yaml.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
